/*.jpeg
/*.jpg

# Build artifacts compilados que NO deben commitearse en source
apps/api/src/**/*.js
apps/api/src/**/*.js.map
apps/api/src/**/*.d.ts
apps/view/src/**/*.js.map
.gstack/

# Herramientas/IDE auxiliares
.continue/
.opencode/
.design-audit-tmp/

# Docs autogeneradas (compodoc)
documentation/

# Artefactos de sesión / reportes one-off (no versionar)
_auth.json
*.tmp
lh-dashboard*
lh-slim.json
prod-*.txt
build-err*.txt
# Exports de chats de WhatsApp sueltos en la raíz (no la lib libs/whatsapp).
/WhatsApp*/
WhatsApp*.zip
database/*.jsonl

# Carpeta de imágenes/exports sueltos en raíz absorbidos al proyecto
_imported/

# Dumps de DB y exports de datos (data, NO código — contiene data de prod)
database/backups/

.angular

# Excel maestro de clientes/rutas (Kepler) — data sensible, no versionar
database/*.xlsx
database/_cli.json

# ERP Kepler dump (228MB, no versionar — restaurar localmente con pg_restore)
database/BACKUP.sql
*.sql.dump

# Backups/dumps sueltos de tiendas (data de prod, no versionar — p.ej. "backup tienda LPA...sql")
database/backup*.sql
# Dumps/exports sueltos en la raíz de database/ (p.ej. "R10 19-06-2026.sql", 42MB+).
# Los .sql legítimos viven en database/scripts/ (subdir, no afectado por esta regla).
database/*.sql

# Config real del servicio del poller on-prem (contiene la clave ingest compartida).
# Se versiona solo service.env.example.
database/importers/kepler/service.env
# Logs y wrapper del servicio (node-windows).
database/importers/kepler/logs/
database/importers/kepler/daemon/

# Fase W — config real del sync Wincaja (contiene la URL de prod Railway) + logs.
# Se versiona solo sync.local.env.example.
database/importers/wincaja/sync.local.env
database/importers/wincaja/logs/

# Orquestador de feeds (pg-boss) — env real con creds prod + cola .245. NUNCA versionar.
database/importers/orchestrator/orchestrator.local.env

# ── Seguridad: scripts de debug/scratch que históricamente hardcodearon
#    credenciales de prod. NUNCA versionar. Usar env (.env) para conexiones.
.claude/settings.local.json
check_migrations.js
_recover.js
database/_recover.js
_tmp*.js
database/_tmp*.js
_kep*.js
database/_kep*.js
_verify*.js
database/_verify*.js

