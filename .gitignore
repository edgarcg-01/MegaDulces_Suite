database/importers/wincaja/.wincaja-live-*.json
database/importers/wincaja/logs/
database/importers/wincaja/_shadow/
database/importers/wincaja/store-agent.cmd
database/importers/wincaja/store-agent.log
database/importers/wincaja/.wincaja-agent-*.json

# ── Higiene de working tree (2026-08-24) — scratch/diagnóstico, NO versionar ──
# Dumps de sesión del navegador (Playwright MCP).
.playwright-mcp/
# Scripts de diagnóstico one-off (viven en el árbol, no son código de producto).
_diag-*.js
database/**/_diag-*.js
