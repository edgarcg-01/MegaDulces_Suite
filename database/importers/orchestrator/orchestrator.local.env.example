# Config del worker de feeds (pg-boss). Copiá a `orchestrator.local.env` (gitignored)
# y llená los valores REALES desde C:\KeplerRunner\run-feeds.cmd. NUNCA versiones el real.

# Cola pg-boss en la .245 (siempre encendida). Creá la DB una vez: CREATE DATABASE feeds_orchestrator;
PGBOSS_DATABASE_URL=postgresql://postgres:<pass>@192.168.0.245:5432/feeds_orchestrator

# Modos que pg-boss POSEE (coma-separado). Vacío = no agenda nada (boot seguro). 'all' = todos.
# Migrá uno por uno y deshabilitá la tarea de Windows equivalente (ver README).
PGBOSS_MODES=

# Destino de los feeds (prod Railway) + fuentes locales — mismos valores que run-feeds.cmd.
DATABASE_URL_NEW=<proxy Railway prod>
DATABASE_URL_KEPLER_CONSOLIDADO=postgresql://postgres:superoot@localhost:5433/kepler_consolidado
MEGA_DULCES_URL=postgresql://postgres:superoot@192.168.0.245:5432/Mega_Dulces
FEEDS_SINK=http
FEEDS_INGEST_URL=https://feeds-ingest-production.up.railway.app
FEEDS_INGEST_KEY=<key>
RECEIPTS_DAYS=7
