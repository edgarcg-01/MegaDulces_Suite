# ─────────────────────────────────────────────────────────────────────────────
# .env DE DESARROLLO LOCAL (Docker) — versión mínima para arrancar rápido.
# Copiá a `.env` y pegá solo las API keys que vayas a usar (pedilas al lead).
#   cp .env.dev.example .env
# Los valores de DB ya apuntan al stack de `npm run dev:up` (docker-compose.dev.yml).
# Para el env COMPLETO (prod, feeds, todos los servicios) ver `.env.example`.
# NUNCA commitear el `.env` real.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PREFIX=api
# Poné cualquier string largo aleatorio para dev (no tiene que ser el de prod).
JWT_SECRET=dev_secret_cambialo_por_algo_largo_y_aleatorio
JWT_EXPIRES_IN=8h
ENABLE_MULTITENANT=true
THROTTLE_DISABLED=false

# ── DBs locales (Docker: npm run dev:up) ─────────────────────────────────────
# Postgres principal :5432 (legacy + multi-tenant) · pgvector :5433 · redis :6379
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/megadulces_logistica
DATABASE_URL_NEW=postgresql://postgres:postgres@localhost:5432/postgres_platform
DATABASE_URL_NEW_RUNTIME=postgresql://app_runtime:app_runtime@localhost:5432/postgres_platform
VECTOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/vector_db
REDIS_URL=redis://localhost:6379

# ── API keys de terceros ─────────────────────────────────────────────────────
# Pedilas al lead (canal seguro). Dejalas vacías si no vas a ejercitar esa feature:
# el API arranca igual, solo se saltan los flujos que las usan.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
GROQ_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAPBOX_TOKEN=

# ── Tests HTTP E2E (database/tests/*.js) ─────────────────────────────────────
API_URL=http://localhost:3334
API_BASE=http://localhost:3334
TENANT=mega_dulces
