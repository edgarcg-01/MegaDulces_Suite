{
  "name": "trade-marketing-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "nx run-many -t serve",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "lint:boundary": "node scripts/lint-boundary-gate.js",
    "typecheck:fast": "tsgo -p tsconfig.ts7.json",
    "api": "nx serve api",
    "api:dev": "nx build api && concurrently -k -n build,api -c blue,green \"nx build api --watch\" \"node --watch dist/apps/api/main.js\"",
    "view": "nx serve view",
    "generate:openapi": "node scripts/generate-openapi.js",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "dev:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "dev:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "dev:bootstrap": "npm run dev:up && npm run migrate:latest && npm run migrate:new",
    "migrate:latest": "knex migrate:latest --knexfile database/knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile database/knexfile.js",
    "migrate:new": "knex migrate:latest --knexfile database/knexfile-newdb.js",
    "seed:run": "knex seed:run --knexfile database/knexfile.js",
    "seed:new": "knex seed:run --knexfile database/knexfile-newdb.js",
    "regression": "node database/run-all-tests.js",
    "vendor:android:sync": "nx build vendor && cap sync android",
    "vendor:android:open": "nx build vendor && cap sync android && cap open android",
    "sync:erp-costs": "node database/scripts/sync-erp-product-costs.js",
    "import:commercial": "node database/importers/commercial_import.js",
    "seed:testdata": "node database/importers/commercial_import.js --type=brands --file=database/importers/testdata/01_brands.json --tenant-slug=mega_dulces && node database/importers/commercial_import.js --type=products --file=database/importers/testdata/02_products.json --tenant-slug=mega_dulces && node database/importers/commercial_import.js --type=prices --file=database/importers/testdata/03_prices.json --tenant-slug=mega_dulces --price-list-code=BASE-MXN && node database/importers/commercial_import.js --type=customers --file=database/importers/testdata/04_customers.json --tenant-slug=mega_dulces && node database/importers/commercial_import.js --type=stock --file=database/importers/testdata/05_stock.json --tenant-slug=mega_dulces --warehouse-code=MD-CENTRAL",
    "cutover:preflight": "node database/scripts/cutover-preflight.js",
    "cutover:smoke": "node database/scripts/cutover-smoke-test.js",
    "embeddings:backfill": "node database/scripts/backfill-product-embeddings.js",
    "embeddings:sync": "node database/scripts/sync-from-remote.js",
    "doc:generate": "compodoc -p apps/view/tsconfig.json -d documentation --hideGenerator --disableGraph --disablePrivate --disableInternal --disableSourceCode",
    "doc:serve": "npx http-server documentation -p 8080 -o",
    "doc:build": "npm run doc:generate",
    "postinstall": "patch-package"
  },
