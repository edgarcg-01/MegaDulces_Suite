{
  "extends": "../../tsconfig.base.json",
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ESNext",
    "module": "preserve",
    "lib": ["ESNext", "dom"],
    "baseUrl": ".",
    "paths": {
      "@megadulces/contracts": ["../../libs/contracts/src/index.ts"],
      "@shared-models": ["../../libs/shared-models/src/index.ts"],
      "@shared-auth/core": ["../../libs/shared-auth/core"],
      "@megadulces/shared-scoring": ["../../libs/shared-scoring/index.ts"],
      "@spartan-ng/helm/*": ["src/app/shared/components/ui/*"]
    },
    "ignoreDeprecations": "6.0",
    "rootDir": "../.."
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
