legacy-peer-deps=true
engine-strict=false
fund=false
audit=false

# Retries más agresivos para builds en Railway/Render donde la red entre
# el builder y el registry de npm puede ser inestable y tira "tarball data
# seems to be corrupted" en cientos de paquetes. Defaults: 3 retries, 1min max.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-timeout=300000

# onnxruntime-node (entra por @imgly/background-removal-node) baja en su postinstall
# el binario de CUDA desde las releases de GitHub. Ese asset devuelve 404 y tira
# `npm ci` entero: el 2026-11-20 dejó ROJOS los cuatro jobs del CI en main
# —incluido `Build & typecheck`, que es compuerta obligatoria— así que `ci-green`
# no se movía y prod no se podía desplegar. No es un fallo de código de nadie.
# Sólo se intenta en linux x64, por eso rompía el CI y no las laptops.
# `skip` sale antes de la descarga (`install.js`: `if (NO_INSTALL) process.exit(0)`).
# La EP de CUDA no se usa: los runners no tienen GPU.
onnxruntime-node-install-cuda=skip
