# Plantilla del env_file de los carriles de ingesta (OBS.4, ADR-053).
#
# El archivo REAL vive FUERA del repo: C:\KeplerRunner\ingest.env  (lleva FEEDS_INGEST_KEY).
# Generarlo sin tipear el secreto:  node ops/ingest/make-env.js
#
# ⚠️ El reparto de variables es lo que evita el bug de 6 días. Ver GOTCHAS §17/§18:
#   ODS_SOURCE_BASE  → la FUENTE (replicas). NUNCA prod.
#   DATABASE_URL_NEW → PROD (destino del reconciliador, por contrato de ese script).
#   ODS_HB_URL       → PROD (destino del latido; var propia para que no caiga en la fuente).

# ── FUENTE: contenedor de replicas lógicas. Desde un contenedor NO se usa `localhost`:
# pgvector-md publica 5432 → :5433 del host, así que se entra por host.docker.internal.
ODS_SOURCE_BASE=postgresql://postgres:CAMBIAME@host.docker.internal:5433/postgres_platform

# ── DESTINO prod (Railway). Mismo valor en las dos: una la lee el reconciliador, la otra el latido.
DATABASE_URL_NEW=postgresql://USUARIO:CAMBIAME@HOST.proxy.rlwy.net:PUERTO/railway
ODS_HB_URL=postgresql://USUARIO:CAMBIAME@HOST.proxy.rlwy.net:PUERTO/railway

# ── SINK: el ship va por HTTP a feeds-ingest (egress; prod no alcanza la LAN).
FEEDS_SINK=http
FEEDS_INGEST_URL=https://feeds-ingest-production.up.railway.app
FEEDS_INGEST_KEY=CAMBIAME

# ── Tenant de los feeds.
CRON_TENANT_ID=00000000-0000-0000-0000-00000000d01c
