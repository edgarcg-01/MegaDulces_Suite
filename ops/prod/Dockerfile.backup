# ─────────────────────────────────────────────────────────────────────────────
# [VL.6.4] El carril del respaldo de producción.
#
# Base `postgres:18` y no Alpine + postgresql-client: un pg_dump 17 NO puede
# volcar un servidor 18 (se niega, no se degrada), y Alpine no publica el cliente
# 18 en su repositorio estable. Esta imagen trae pg_dump/pg_restore/psql 18.6 —
# la MISMA minor que el servidor de prod, verificado contra `select version()`.
#
# Pesa ~150 MB más que una Alpine. Es el precio de que el cliente coincida con el
# servidor en la única herramienta cuyo trabajo es que la copia sea fiel.
# ─────────────────────────────────────────────────────────────────────────────
FROM postgres:18

# ⚠️ EL PIN ES `pgdg13`, NO `pgdg12` COMO EN `Dockerfile.pg`. Las dos imágenes escriben el
# MISMO repositorio de pgBackRest pero están sobre Debian distintas — medido el 2026-09-22:
# `postgres:18` es **trixie** (Debian 13) y `pgvector/pgvector:pg18` es **bookworm** (12).
# Lo que tiene que coincidir es la versión de ARRIBA (2.59.1, que define el formato del
# repositorio); la revisión de Debian es de cada base. Copiar el pin de la otra hace fallar
# el build con `apt` exit 100, que no menciona ni Debian ni la versión.
# `[OPS.OFF.1]` + rclone (y ca-certificates, que `--no-install-recommends` deja afuera y sin el
# cual el TLS contra R2 falla): la copia fuera de md, `offsite-sync.sh`.
# ⛔ 2026-10-31: el pin `2.59.1-1.pgdg13+1` YA NO EXISTE en apt.postgresql.org (quedan 2.59.2,
#    2.59.3 y 2.60.0): este Dockerfile no se podía reconstruir desde antes de este cambio, y nadie lo
#    supo porque la imagen no se reconstruía. Se fija 2.59.3 — misma serie que el 2.59.1 con que
#    `pg-prod` archiva el WAL (`Dockerfile.pg`, que tiene el mismo problema con pgdg12 y se declara).
#    Verificado antes de cambiarlo: 2.59.3 lee el repositorio real (`info`, sólo lectura) igual.
RUN apt-get update \
 && apt-get install -y --no-install-recommends cron pgbackrest=2.59.3-1.pgdg13+1 rclone ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY ops/prod/backup-prod.sh    /usr/local/bin/backup-prod.sh
COPY ops/prod/pgbackrest-run.sh /usr/local/bin/pgbackrest-run.sh
COPY ops/prod/offsite-sync.sh   /usr/local/bin/offsite-sync.sh
COPY ops/prod/pgbackrest.conf   /etc/pgbackrest/pgbackrest.conf
COPY ops/prod/crontab.backup    /etc/cron.d/backup-prod

# cron IGNORA un archivo de /etc/cron.d escribible por grupo u otros, y lo hace en
# silencio. El chmod no es higiene: es la diferencia entre que corra y que no.
RUN chmod 0755 /usr/local/bin/backup-prod.sh /usr/local/bin/pgbackrest-run.sh /usr/local/bin/offsite-sync.sh \
 && chmod 0644 /etc/cron.d/backup-prod /etc/pgbackrest/pgbackrest.conf \
 && chown root:root /etc/cron.d/backup-prod

# ⛔ Hay que ANULAR el entrypoint de la imagen: `docker-entrypoint.sh` de postgres
# intenta inicializar un clúster y aborta pidiendo POSTGRES_PASSWORD. Acá el
# contenedor no es una base, es un cliente.
ENTRYPOINT []
CMD ["cron", "-f", "-L", "2"]
