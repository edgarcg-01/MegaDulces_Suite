# syntax=docker/dockerfile:1.7
# ─────────────────────────────────────────────────────────────────────────────
# Trade Marketing — Dockerfile del WORKER-TIER (INFRA.3, ADR-043)
#
# Corre el MISMO código del API pero en modo worker (WORKER=true → bootstrapWorker
# en main.ts: crons + cola pg-boss, SIN HTTP/WS/nginx). Por eso:
#   - Compila SOLO `api` (no el bundle Angular de `view`) → build más rápido/liviano.
#   - NO trae nginx (el worker no sirve nada).
#   - NO usa `--mount=type=cache,id=s/<service-id>-...` — esos ids están clavados
#     al service del API (69f64078) y Railway los rechaza en OTRO servicio
#     ("missing the cacheKey prefix from its id"). Sin cache mounts = válido en
#     cualquier servicio (a costa de re-descargar deps en cada build).
#   - Incluye chromium (puppeteer) + fonts por si algún cron genera PDF/imagen.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: deps completas (para compilar) ─────────────────────────────────
FROM node:20-bookworm-slim AS deps
WORKDIR /app
ENV NPM_CONFIG_LOGLEVEL=warn \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false \
    CI=true \
    PUPPETEER_SKIP_DOWNLOAD=true
COPY package*.json .npmrc ./
RUN npm ci --prefer-offline

# ── Stage 2: compilar SOLO la api (SWC, sin Angular) ────────────────────────
FROM node:20-bookworm-slim AS builder
WORKDIR /app
ENV NX_DAEMON=false CI=true
COPY --from=deps /app/node_modules ./node_modules
# ⛔ `vitest.shared.ts`: lo importan los `vitest.config.ts` de `apps/`+`libs/`, y el plugin
# `@nx/vitest` los carga para armar el grafo en CUALQUIER comando de Nx. Sin él, "Failed to
# process project graph" y el build no arranca. Detalle en el `Dockerfile` principal.
COPY nx.json package.json package-lock.json tsconfig*.json .npmrc vitest.shared.ts ./
COPY apps ./apps
COPY libs ./libs
COPY database ./database

# `[NX.4]` Caché REMOTO de Nx (Nx Cloud). Se pasa como build arg desde Railway; si falta o
# viene mal, Nx imprime un warning y sigue con caché local — MEDIDO con un token inventado:
# "Invalid Credentials (CI Access Token) ... (code: 401)" y el comando igual salió en 0. O sea
# que esto no puede tumbar un deploy.
#
# ⭐ Acá es donde más paga, y no es teoría: este Dockerfile corre `nx build api`, que es
# EXACTAMENTE la misma tarea que el `Dockerfile` principal ya compiló para el servicio api, del
# mismo commit, minutos antes. Hasta hoy se compilaba DOS VECES por release, porque cada
# servicio de Railway tiene su propio cache mount y un mount es por-servicio: no hay forma de
# que el worker vea lo que compiló la api. El caché remoto sí cruza esa frontera — es la única
# capa compartida entre servicios (y entre máquinas).
#
# Y este stage no tenía NINGÚN cache mount, así que hasta el redeploy del mismo commit
# recompilaba entero.
# ⛔ El token va por `ENV` en línea propia, NO asignado adentro del `RUN`. BuildKit imprime cada
# `RUN` **con los ARG ya expandidos**, así que la forma inline publica el secreto en texto plano
# en el log de build. No es hipotético: pasó en el primer deploy real del 2026-09-18, y el log de
# Railway mostró `NX_CLOUD_ACCESS_TOKEN="NDQw…"` completo. Las instrucciones `ENV` no se imprimen
# como paso, así que el valor no aparece. Medido con un control negativo: la variante inline
# imprime `RUN SECRETO="VALOR-SUPER-SECRETO-123" …` y la variante `ENV` no imprime nada.
# Vive sólo en el stage `builder`, que es descartable — el runner es otro `FROM`.
ARG NX_CLOUD_ACCESS_TOKEN=
ENV NX_CLOUD_ACCESS_TOKEN=${NX_CLOUD_ACCESS_TOKEN}
RUN NODE_OPTIONS="--max-old-space-size=4096" \
    npx nx build api --configuration=production

# ── Stage 3: deps solo de producción ────────────────────────────────────────
FROM node:20-bookworm-slim AS prod-deps
WORKDIR /app
ENV NPM_CONFIG_LOGLEVEL=warn \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false \
    CI=true
COPY package*.json .npmrc ./
RUN npm ci --omit=dev --ignore-scripts --prefer-offline

# ── Stage 4: imagen final ────────────────────────────────────────────────────
FROM node:20-slim AS runner
WORKDIR /app
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        chromium \
        fonts-liberation \
        fonts-noto-color-emoji \
        tzdata && \
    ln -sf /usr/share/zoneinfo/America/Mexico_City /etc/localtime && \
    rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    TZ=America/Mexico_City \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    PUPPETEER_SKIP_DOWNLOAD=true

# El heap se capa por env NODE_OPTIONS (seteado en el servicio Railway).
COPY --from=builder  --chown=node:node /app/dist/apps/api ./dist/apps/api
COPY --from=builder  --chown=node:node /app/database     ./database
COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules

STOPSIGNAL SIGTERM
USER node
# Modo worker: WORKER=true (env del servicio) → bootstrapWorker() en main.ts.
CMD ["node", "dist/apps/api/main.js"]
